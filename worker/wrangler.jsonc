{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olympradar",
  "main": "entrypoint.js",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "olympradar",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
}
